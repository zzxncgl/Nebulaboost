env.NebulaBoostCleanup = function()
    for _, m in ipairs({ Graphics, Textures, Effects, Accessories }) do
        pcall(m.disable)
    end
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
end

