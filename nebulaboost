------------------------------------------------------------------
-- 1. MÓDULOS DE OPTIMIZACIÓN
--    Cada módulo guarda los valores originales para poder restaurarlos.
------------------------------------------------------------------
local function createModule(cfg)
    local M = {
        active = false,
        saved  = {},   -- [instancia] = { propiedad = valorOriginal }
        conns  = {},
        token  = 0,    -- invalida escaneos antiguos
    }

    -- Cambia una propiedad guardando antes su valor original
    function M.set(inst, prop, value)
        return pcall(function()
            local bucket = M.saved[inst]
            if not bucket then
                bucket = {}
                M.saved[inst] = bucket
            end
            if bucket[prop] == nil then
                bucket[prop] = inst[prop]
            end
            inst[prop] = value
        end)
    end

    function M.enable()
        if M.active then return end
        M.active = true
        M.token += 1
        local myToken = M.token

        if cfg.onEnable then pcall(cfg.onEnable, M) end

        -- Escaneo inicial en lotes para no congelar el juego
        task.spawn(function()
            local n = 0
            for _, root in ipairs(cfg.roots()) do
                for _, inst in ipairs(root:GetDescendants()) do
                    if not M.active or M.token ~= myToken then return end
                    pcall(cfg.process, M, inst)
                    n += 1
                    if n % 300 == 0 then task.wait() end
                end
            end
        end)

        -- Objetos que aparezcan después también se optimizan
        for _, root in ipairs(cfg.roots()) do
            table.insert(M.conns, root.DescendantAdded:Connect(function(inst)
                if M.active then
                    task.defer(function()
                        pcall(cfg.process, M, inst)
                    end)
                end
            end))
        end
    end

    function M.disable()
        if not M.active then return end
        M.active = false
        M.token += 1

        for _, c in ipairs(M.conns) do c:Disconnect() end
        M.conns = {}

        for inst, props in pairs(M.saved) do
            for prop, value in pairs(props) do
                pcall(function() inst[prop] = value end)
            end
        end
        M.saved = {}

        if cfg.onDisable then pcall(cfg.onDisable, M) end
    end

    return M
end

-- 1.1 GRÁFICOS AL MÍNIMO -------------------------------------------------
local Graphics = createModule({
    roots = function() return { Lighting } end,

    process = function(M, inst)
        if inst:IsA("PostEffect") then            -- Blur, Bloom, SunRays, DoF, ColorCorrection
            M.set(inst, "Enabled", false)
        elseif inst:IsA("Atmosphere") then
            M.set(inst, "Density", 0)
            M.set(inst, "Haze", 0)
        elseif inst:IsA("Clouds") then
            M.set(inst, "Enabled", false)
        end
    end,

    onEnable = function(M)
        -- Iluminación
        M.set(Lighting, "GlobalShadows", false)
        M.set(Lighting, "ShadowSoftness", 0)
        M.set(Lighting, "EnvironmentSpecularScale", 0)

        -- Terreno / agua
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            M.set(terrain, "WaterWaveSize", 0)
            M.set(terrain, "WaterWaveSpeed", 0)
            M.set(terrain, "WaterReflectance", 0)
            M.set(terrain, "Decoration", false)
        end

        -- Calidad gráfica global
        pcall(function()
            local r = settings().Rendering
            M.origQuality = r.QualityLevel
            r.QualityLevel = Enum.QualityLevel.Level01
        end)

        -- Tecnología de iluminación (solo si el ejecutor lo permite)
        if gethiddenproperty and sethiddenproperty then
            pcall(function()
                M.origTech = gethiddenproperty(Lighting, "Technology")
                sethiddenproperty(Lighting, "Technology", Enum.Technology.Compatibility)
            end)
        end
    end,

    onDisable = function(M)
        pcall(function()
            if M.origQuality then settings().Rendering.QualityLevel = M.origQuality end
        end)
        if M.origTech and sethiddenproperty then
            pcall(function() sethiddenproperty(Lighting, "Technology", M.origTech) end)
        end
        M.origQuality, M.origTech = nil, nil
    end,
})

-- 1.2 TEXTURAS LIGERAS ---------------------------------------------------
local Textures = createModule({
    roots = function() return { Workspace } end,

    process = function(M, inst)
        if inst:IsA("Terrain") then return end

        if inst:IsA("BasePart") then
            M.set(inst, "Material", Enum.Material.SmoothPlastic)
            M.set(inst, "Reflectance", 0)
            M.set(inst, "CastShadow", false)
            if inst:IsA("MeshPart") then
                M.set(inst, "TextureID", "")
            end
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            M.set(inst, "Transparency", 1)
        elseif inst:IsA("SurfaceAppearance") then
            M.set(inst, "Parent", nil) -- se restaura al volver a su padre original
        end
    end,
})

-- 1.3 LIMPIAR EFECTOS PESADOS --------------------------------------------
local Effects = createModule({
    roots = function() return { Workspace } end,

    process = function(M, inst)
        if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
            or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles")
            or inst:IsA("Highlight") or inst:IsA("Light") then
            M.set(inst, "Enabled", false)
        end
    end,
})

-- 1.4 OCULTAR ACCESORIOS AJENOS ------------------------------------------
local function isOtherAccessory(inst)
    local acc = inst:IsA("Accessory") and inst or inst:FindFirstAncestorOfClass("Accessory")
    if not acc then return false end
    local char = acc.Parent
    return char ~= nil
        and char ~= LocalPlayer.Character
        and char:FindFirstChildOfClass("Humanoid") ~= nil
end

local Accessories = createModule({
    roots = function() return { Workspace } end,

    process = function(M, inst)
        if inst:IsA("BasePart") then
            if isOtherAccessory(inst) then
                M.set(inst, "Transparency", 1)
                M.set(inst, "CastShadow", false)
            end
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            if isOtherAccessory(inst) then
                M.set(inst, "Transparency", 1)
            end
        elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") then
            if isOtherAccessory(inst) then
                M.set(inst, "Enabled", false)
            end
        end
    end,
})

