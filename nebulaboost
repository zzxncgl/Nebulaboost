local menuOpen = false

local function setMenu(open)
    menuOpen = open
    if open then
        menuScale.Scale = 0.85
        menu.Visible = true
        tween(menuScale, 0.28, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    else
        local t = tween(menuScale, 0.15, { Scale = 0.85 })
        t.Completed:Connect(function()
            if not menuOpen then menu.Visible = false end
        end)
    end
end

