local toggleVisuals = {} -- funciones para refrescar el estado visual de cada interruptor

local function addToggle(order, name, desc, module)
    local row = new("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = C.row,
        AutoButtonColor = false,
        Text = "",
        LayoutOrder = order,
        Parent = scroll,
    })
    corner(row, 12)
    local stroke = new("UIStroke", {
        Color = C.violet, Transparency = 0.7, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = row,
    })

    new("TextLabel", {
        Position = UDim2.fromOffset(12, 8),
        Size = UDim2.new(1, -74, 0, 18),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = C.text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })
    new("TextLabel", {
        Position = UDim2.fromOffset(12, 27),
        Size = UDim2.new(1, -74, 0, 28),
        BackgroundTransparency = 1,
        Text = desc,
        TextColor3 = C.muted,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = row,
    })

    local track_ = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(42, 22),
        BackgroundColor3 = C.off,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(track_, 11)
    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = C.muted,
        BorderSizePixel = 0,
        Parent = track_,
    })
    corner(knob, 8)

    local function refresh()
        if module.active then
            tween(track_, 0.2, { BackgroundColor3 = C.violet })
            tween(knob, 0.2, { Position = UDim2.new(1, -19, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1) })
            tween(stroke, 0.2, { Transparency = 0.15, Color = C.blue })
        else
            tween(track_, 0.2, { BackgroundColor3 = C.off })
            tween(knob, 0.2, { Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = C.muted })
            tween(stroke, 0.2, { Transparency = 0.7, Color = C.violet })
        end
    end
    table.insert(toggleVisuals, refresh)

    track(row.MouseButton1Click:Connect(function()
        if module.active then module.disable() else module.enable() end
        refresh()
    end))
end

