-- 5. ANIMACIÓN NEÓN + CONTADOR DE FPS
------------------------------------------------------------------
local frames, elapsed = 0, 0
track(RunService.RenderStepped:Connect(function(dt)
    for _, g in ipairs(spinning) do
        g.Rotation = (g.Rotation + dt * 50) % 360
    end
    frames += 1
    elapsed += dt
    if elapsed >= 0.5 then
        footer.Text = string.format("FPS %d  |  RAM %d MB", math.floor(frames / elapsed + 0.5), math.floor(collectgarbage("count") / 1024))
        frames, elapsed = 0, 0
    end
end))

